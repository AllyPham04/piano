results/run_log.jsonl
results/thresholds/

# --- Run outputs (large / regenerable) ---
outputs/
outputs_smoke/
results_smoke/
figures_smoke/

# --- Large binary files anywhere ---
*.wav
*.flac
*.mp3
*.npy
*.npz
*.sf2
*.zip
*.parquet
*.pt
